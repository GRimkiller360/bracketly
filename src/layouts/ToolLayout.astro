---
import BaseLayout from './BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import { getCategoryColor, tools, type Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = siteUrl + Astro.url.pathname;
const categoryColor = getCategoryColor(tool.category);
const metaDescription = tool.metaDescription ?? tool.description;
const relatedTools = tools
  .filter((t) => t.category === tool.category && t.slug !== tool.slug)
  .slice(0, 4);

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  description: metaDescription,
  url: pageUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (runs in browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={tool.title}
  description={metaDescription}
  keywords={tool.keywords.join(', ')}
>
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container">
    <a
      href="/"
      style="color:var(--text-muted);font-size:0.88rem;display:inline-flex;align-items:center;gap:0.3rem;margin-bottom:1.5rem;"
    >
      ← All tools
    </a>

    <div class="tool-header" style={`--card-accent-light:${categoryColor.light};--card-accent-dark:${categoryColor.dark};`}>
      <div class="icon" style="margin-bottom:0.6rem;">{tool.icon}</div>
      <span class="pill">{tool.category}</span>
      <h1>{tool.title}</h1>
      <p>{tool.description}</p>
      <span class="privacy-note">🔒 Runs entirely in your browser — no data is ever sent anywhere</span>
    </div>

    <slot />

    <AdUnit />

    <section style="margin-top:2.5rem;">
      {tool.content.map((c) => (
        <div class="panel" style="margin-bottom:1.25rem;">
          <h2 style="margin:0 0 0.5rem;font-size:1.1rem;">{c.heading}</h2>
          <p style="color:var(--text-muted);margin:0;font-size:0.95rem;line-height:1.7;">{c.body}</p>
        </div>
      ))}
    </section>

    <section style="margin-top:2.5rem;">
      <h2 style="font-size:1.15rem;margin:0 0 1rem;">Frequently asked questions</h2>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        {tool.faq.map((f) => (
          <details class="panel" style="padding:0.9rem 1.1rem;">
            <summary style="cursor:pointer;font-weight:600;font-size:0.95rem;">{f.q}</summary>
            <p style="color:var(--text-muted);margin:0.6rem 0 0;font-size:0.92rem;">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {relatedTools.length > 0 && (
      <section style="margin-top:2.5rem;">
        <h2 style="font-size:1.15rem;margin:0 0 1rem;">Related {tool.category} tools</h2>
        <div class="tool-grid" style={`--card-accent-light:${categoryColor.light};--card-accent-dark:${categoryColor.dark};`}>
          {relatedTools.map((t) => (
            <a href={`/tools/${t.slug}/`} class="tool-card">
              <div class="icon">{t.icon}</div>
              <h3>{t.shortTitle}</h3>
              <p>{t.description.split(/\.(?=\s|$)/)[0]}.</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="panel" style="text-align:center;padding:2.25rem;margin-top:2.5rem;">
      <p style="margin:0 0 1rem;font-size:1.05rem;">
        Bracketly is free and open-source. If this tool saved you time, consider supporting it.
      </p>
      <a href="/donate/" class="btn btn-support" style="font-size:1rem;padding:0.65rem 1.4rem;">
        ☕ Buy me a coffee
      </a>
    </div>
  </div>
</BaseLayout>
