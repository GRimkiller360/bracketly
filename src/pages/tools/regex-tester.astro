---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getTool } from '../../data/tools';

const tool = getTool('regex-tester')!;
---

<ToolLayout tool={tool}>
  <div class="panel" style="margin-bottom:1rem;">
    <div style="display:flex;gap:0.75rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:0.75rem;">
      <div style="flex:1;min-width:200px;">
        <div class="field-label"><label for="pattern">Pattern</label></div>
        <input
          id="pattern"
          type="text"
          placeholder="e.g.  \b\w+@\w+\.\w+\b"
          style="font-family:var(--font-mono);font-size:0.9rem;"
        />
      </div>
      <div style="width:120px;">
        <div class="field-label"><label for="flags">Flags</label></div>
        <input
          id="flags"
          type="text"
          value="gm"
          placeholder="gim"
          style="font-family:var(--font-mono);font-size:0.9rem;"
        />
      </div>
    </div>
    <div class="field-label">
      <label for="test-string">Test string</label>
      <span style="display:flex;align-items:center;gap:0.6rem;">
        <span id="match-count" aria-live="polite" style="font-weight:700;color:var(--accent);"></span>
        <button class="btn btn-sm" id="btn-clear">Clear</button>
      </span>
    </div>
    <textarea id="test-string" rows="7" autocomplete="off" placeholder="Paste text to test against…"></textarea>
    <div id="status" class="status" role="status" aria-live="polite"></div>
  </div>

  <div id="matches-panel" style="display:none;">
    <div class="field-label">
      <label for="matches-out">Matches &amp; capture groups</label>
      <button class="btn btn-sm" id="btn-copy-matches" aria-label="Copy matches">Copy</button>
    </div>
    <textarea id="matches-out" rows="10" readonly style="font-size:0.82rem;"></textarea>
  </div>
</ToolLayout>

<script is:inline>
  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function (resolve, reject) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        ok ? resolve() : reject(new Error('execCommand copy failed'));
      } catch (e) {
        reject(e);
      }
    });
  }

  var patternEl   = document.getElementById('pattern');
  var flagsEl     = document.getElementById('flags');
  var testStr     = document.getElementById('test-string');
  var matchCount  = document.getElementById('match-count');
  var statusEl    = document.getElementById('status');
  var matchesPanel = document.getElementById('matches-panel');
  var matchesOut  = document.getElementById('matches-out');

  // Matching runs in a Web Worker so a pathological pattern (e.g. the
  // classic catastrophic-backtracking case ^(a+)+$) can be aborted by
  // terminating the worker instead of freezing the whole tab — a native
  // regex exec on the main thread can't be interrupted once it starts.
  var MATCH_TIMEOUT_MS = 2000;
  var worker = null;
  var runToken = 0;
  var timeoutHandle = null;

  function workerSource() {
    self.onmessage = function (e) {
      var pat = e.data.pattern, flags = e.data.flags, text = e.data.text;
      var re;
      try {
        re = new RegExp(pat, flags);
      } catch (err) {
        self.postMessage({ error: err.message });
        return;
      }
      var matches = [];
      try {
        var m;
        while ((m = re.exec(text)) !== null) {
          matches.push({
            index: m.index,
            text: m[0],
            groups: m.slice(1).map(function (g) { return g === undefined ? null : g; }),
            named: m.groups || null,
          });
          if (m[0].length === 0) re.lastIndex++;
        }
      } catch (err) {
        self.postMessage({ error: err.message });
        return;
      }
      self.postMessage({ matches: matches });
    };
  }

  function getWorker() {
    if (worker) return worker;
    var src = '(' + workerSource.toString() + ')();';
    var blob = new Blob([src], { type: 'application/javascript' });
    worker = new Worker(URL.createObjectURL(blob));
    return worker;
  }

  function killWorker() {
    if (worker) {
      worker.terminate();
      worker = null;
    }
  }

  function renderMatches(matches, flagWarning) {
    matchCount.textContent = matches.length + ' match' + (matches.length !== 1 ? 'es' : '');

    if (matches.length === 0) {
      statusEl.textContent = flagWarning + 'No matches found.';
      statusEl.className   = flagWarning ? 'status warning' : 'status';
      return;
    }

    var lines = matches.map(function (m, i) {
      var line = 'Match ' + (i + 1) + ' [' + m.index + '–' + (m.index + m.text.length) + ']: ' + JSON.stringify(m.text);
      if (m.groups.length > 0) {
        var groups = m.groups.map(function (g, gi) {
          return '  Group ' + (gi + 1) + ': ' + (g === null ? '(no match)' : JSON.stringify(g));
        });
        line += '\n' + groups.join('\n');
      }
      if (m.named && Object.keys(m.named).length) {
        line += '\n  Named: ' + JSON.stringify(m.named);
      }
      return line;
    });

    matchesOut.value = lines.join('\n\n');
    matchesPanel.style.display = 'block';
    if (flagWarning) {
      statusEl.textContent = flagWarning + matches.length + ' match' + (matches.length !== 1 ? 'es' : '') + ' found';
      statusEl.className   = 'status warning';
    } else {
      statusEl.textContent = '✓ ' + matches.length + ' match' + (matches.length !== 1 ? 'es' : '') + ' found';
      statusEl.className   = 'status ok';
    }
  }

  function test() {
    var pat = patternEl.value;
    var rawFlags = flagsEl.value;
    var fl  = rawFlags.replace(/[^dgimsuvy]/g, '');
    fl = fl.split('').filter(function (c, i) { return fl.indexOf(c) === i; }).join('');

    var myToken = ++runToken;
    clearTimeout(timeoutHandle);

    statusEl.textContent = '';
    statusEl.className   = 'status';
    matchCount.textContent = '';
    matchesPanel.style.display = 'none';

    if (!pat) return;

    var flagWarning = fl !== rawFlags
      ? '⚠ Ignored unsupported or duplicate flag character(s) — using "' + fl + '". '
      : '';

    var text = testStr.value;
    try {
      // Cheap up-front validity check so an invalid pattern reports
      // immediately without waiting on the worker round-trip.
      new RegExp(pat, fl);
    } catch (e) {
      statusEl.textContent = flagWarning + '✗ Invalid pattern: ' + e.message;
      statusEl.className   = 'status error';
      return;
    }

    var flags = fl.includes('g') ? fl : fl + 'g';
    statusEl.textContent = flagWarning + 'Running…';
    statusEl.className   = flagWarning ? 'status warning' : 'status';

    var w = getWorker();
    w.onmessage = function (e) {
      if (myToken !== runToken) return;
      clearTimeout(timeoutHandle);
      if (e.data.error) {
        statusEl.textContent = flagWarning + '✗ Invalid pattern: ' + e.data.error;
        statusEl.className   = 'status error';
        return;
      }
      renderMatches(e.data.matches, flagWarning);
    };
    w.onerror = function () {
      if (myToken !== runToken) return;
      clearTimeout(timeoutHandle);
      killWorker();
      statusEl.textContent = flagWarning + '✗ Matching failed unexpectedly.';
      statusEl.className   = 'status error';
    };
    w.postMessage({ pattern: pat, flags: flags, text: text });

    timeoutHandle = setTimeout(function () {
      if (myToken !== runToken) return;
      killWorker();
      statusEl.textContent = flagWarning + '⚠ This pattern is taking too long against the current text — likely catastrophic backtracking from nested quantifiers (e.g. (a+)+). Simplify the pattern or shorten the test string.';
      statusEl.className   = 'status error';
      matchCount.textContent = '';
    }, MATCH_TIMEOUT_MS);
  }

  var debounceTimer = null;
  function debouncedTest() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(test, 200);
  }

  patternEl.addEventListener('input', debouncedTest);
  flagsEl.addEventListener('input', debouncedTest);
  testStr.addEventListener('input', debouncedTest);

  document.getElementById('btn-clear').addEventListener('click', function () {
    patternEl.value = '';
    flagsEl.value = 'gm';
    testStr.value = '';
    test();
    patternEl.focus();
  });

  document.getElementById('btn-copy-matches').addEventListener('click', function () {
    if (!matchesOut.value) return;
    var btn = this;
    copyText(matchesOut.value).then(function () {
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
    }, function () {
      btn.textContent = 'Copy failed';
      setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
    });
  });
</script>
